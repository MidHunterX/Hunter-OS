LC_CTYPE
copy "i18n"
translit_start
include "translit_combining";""
translit_end
END LC_CTYPE


LC_COLLATE
% Copy the template from ISO/IEC 14651
copy "iso14651_t1"
END LC_COLLATE


LC_MONETARY
% "Dolla dolla bills y'all" — Wu Tang Clan
copy "en_US"
END LC_MONETARY


LC_NUMERIC
decimal_point          "."
thousands_sep          ","
grouping               3;2
END LC_NUMERIC


LC_TIME
% Abbreviated weekday names (%a)
abday       "Sun";"Mon";"Tue";"Wed";"Thu";"Fri";"Sat"
% Full weekday names (%A)
day         "Sunday";"Monday";/
            "Tuesday";"Wednesday";/
            "Thursday";"Friday";/
            "Saturday"
% Abbreviated month names (%b)
abmon       "Pri";"Sec";/
            "Ter";"Quart";/
            "Quin";"Sex";/
            "Sep";"Oct";/
            "Nov";"Dec";/
            "Undec";"Duodec"
% Full month names (%B)
mon         "Primilis";"Secundilis";/
            "Tertilis";"Quartilis";/
            "Quintilis";"Sextilis";/
            "September";"October";/
            "November";"December";/
            "Undecember";"Duodecember"
% No need of AM PM because we usin' 24 hr over here just like the Earth
am_pm       "";""
% date and time representation
d_t_fmt     "%Y-%m-%dT%H:%M:%S"
% date and time representation for date(1)
date_fmt    "%Y-%m-%dT%H:%M:%S%z"
% date representation (%x)
d_fmt       "%Y-%m-%d"
% time representation
t_fmt       "%H:%M:%S%z"
% 12 h time representation (%r)
t_fmt_ampm  "%H:%M:%S"
week 7;19971130;1
END LC_TIME


LC_MESSAGES
copy "en_US"
END LC_MESSAGES


LC_PAPER
copy "i18n"
END LC_PAPER


LC_NAME
name_fmt    "%p%t%g%t%m%t%f"
name_gen    ""
name_mr     "Mr."
name_mrs    "Mrs."
name_miss   "Ms."
name_ms     ""
END LC_NAME


LC_ADDRESS
postal_fmt              "%z%c%T%s%b%e%r"
