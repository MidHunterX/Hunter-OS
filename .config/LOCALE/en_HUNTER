% --------------------------------------------------------------------------- %

LC_IDENTIFICATION
title       "English language locale for Hunter OS"
source      "MidHunterX"
address     "in my enclosed room, Earth, Solar System, Orion–Cygnus Arm, Milkyway Galaxy, Near Proxima Centauri"
contact     "Personal Carrier Pigeon"
email       "attach the message to my pigeon"
tel         ""
fax         ""
language    "English"
territory   "Earth"
revision    "1.0"
date        "2026-05-18"
category "i18n:2012";LC_IDENTIFICATION
category "i18n:2012";LC_CTYPE
category "i18n:2012";LC_COLLATE
category "i18n:2012";LC_TIME
category "i18n:2012";LC_NUMERIC
category "i18n:2012";LC_MONETARY
